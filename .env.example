# Copy to .env and fill in. Never commit .env -- it is gitignored.

# --- LLM providers (fallback chain, in order) -------------------------------
# Leave a key blank to skip that provider entirely. With all four blank the
# gateway falls through to the offline stub if ALLOW_STUB_PROVIDER=true.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_S=60
LLM_RETRIES=2
LLM_MAX_TOKENS=2048

# Deterministic offline provider, last in the chain. Handy for local demos and
# CI. Leave false in any environment where a placeholder answer could be
# mistaken for a real one.
ALLOW_STUB_PROVIDER=false

# --- Memory -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://agentforge:agentforge@localhost:5432/agentforge
SESSION_TTL_S=3600
CACHE_TTL_S=900
# Cosine similarity above which a rephrased request counts as a cache hit.
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_INDEX_SIZE=200
EMBEDDING_DIM=384

# --- Guardrails -------------------------------------------------------------
# Tier 3 costs an LLM call per escalation; only the uncertain band escalates.
GUARDRAILS_LLM_TIER=false
GUARDRAILS_BLOCK_THRESHOLD=0.6

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Monitoring & alerting (Phase 7) -----------------------------------------
# Custom rules only -- native LangSmith/LangWatch/Arize alerts are configured
# in each vendor's dashboard; see README "Monitoring & alerting".
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Stub only -- logs "not implemented" until a real Events API v2 integration exists.
PAGERDUTY_ROUTING_KEY=

# A fingerprint that keeps firing inside this window sends one notification,
# not one per evaluation.
ALERT_DEDUP_WINDOW_S=900
# Where dedup/silence/acknowledge state lives. "redis" shares it between the
# console and the sweep CronJob; "memory" is single-process and only correct
# for a local run. Reuses REDIS_URL above.
ALERT_STATE_BACKEND=redis
# How long the console's "Silence" button mutes an alert for.
ALERT_SILENCE_DEFAULT_S=3600

ALERT_GUARDRAIL_RATE_MAX=0.3
ALERT_GUARDRAIL_MIN_SAMPLES=5
ALERT_ESCALATION_RATE_MAX=0.25
ALERT_ESCALATION_MIN_SAMPLES=5
# Consecutive tool_call failures for the same action name that count as a trip.
ALERT_BREAKER_FAILURES=3
ALERT_REDTEAM_SEVERITY=critical

# --- Agentic OS -------------------------------------------------------------
# Root of the kernel/persona/command files. Blank = packaged agentos/ directory.
AGENTFORGE_OS_DIR=
# Append run records to <os_dir>/data/journal/runs.jsonl.
OS_JOURNAL=true
